// Cloudflare Workers config: serves the Vite build (dist/) as a static site.
// The Cloudflare build runs `npm run build`, then `npx wrangler deploy`, which reads this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techdemo-2",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
